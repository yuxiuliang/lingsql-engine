# ----------------------------
# 基础组件
# ----------------------------
MYSQL_ROOT_PASSWORD=ChangeMe_MySQL_Root_2026
MYSQL_DATABASE=lingsql_engine_db
MYSQL_APP_USERNAME=lingsql_app
MYSQL_APP_PASSWORD=ChangeMe_MySQL_App_2026
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_PORT=3306

# 付费试点演示业务库（仅用于样例数据，应用以只读账号访问）
LINGSQL_DEMO_ENABLED=true
LINGSQL_DEMO_DATABASE=lingsql_demo_sales
LINGSQL_DEMO_USERNAME=lingsql_demo_reader
LINGSQL_DEMO_PASSWORD=ChangeMe_Demo_ReadOnly_2026
LINGSQL_DEMO_TENANT_ID=demo_sales
LINGSQL_DEMO_TENANT_NAME=销售库存演示租户
LINGSQL_DEMO_PLAN_NAME=标准版
LINGSQL_DEMO_ADMIN_USERNAME=demo_admin
LINGSQL_DEMO_ADMIN_INITIAL_PASSWORD=ReplaceWithOneTimeDemoAdminPassword_2026
LINGSQL_DEMO_ADMIN_PASSWORD=ReplaceWithFinalDemoAdminPassword_2026
LINGSQL_DEMO_ADMIN_NICKNAME=演示管理员

# 一键演示试点可复用现有 HEALTHY 模型；如需自动创建/更新模型，填写以下参数。
LINGSQL_DEMO_MODEL_PROVIDER=
LINGSQL_DEMO_MODEL_NAME=
LINGSQL_DEMO_MODEL_VERSION=
LINGSQL_DEMO_MODEL_BASE_URL=
LINGSQL_DEMO_MODEL_API_KEY=
LINGSQL_RUNTIME_DATA_SNAPSHOT_ID=demo-sales-20260815-v1

REDIS_PASSWORD=ChangeMe_Redis_2026
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_PORT=6379

APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8000

# ----------------------------
# 应用安全参数（必须替换）
# ----------------------------
LINGSQL_JWT_SECRET=ReplaceWithAtLeast32Chars_2026
LINGSQL_DATA_ENCRYPTION_KEY=ReplaceWithAtLeast48Chars_2026

# ----------------------------
# 初始化超级管理员（必须替换）
# ----------------------------
LINGSQL_ADMIN_ENABLED=true
LINGSQL_ADMIN_TENANT_ID=sys_tenant
LINGSQL_ADMIN_TENANT_NAME=系统租户
LINGSQL_ADMIN_USERNAME=admin
LINGSQL_ADMIN_PASSWORD=ReplaceWithStrongAdminPassword_2026
LINGSQL_ADMIN_NICKNAME=系统管理员

# ----------------------------
# 可选运行策略
# ----------------------------
LINGSQL_ALERT_ENABLED=false
LINGSQL_CORS_ENABLED=false
LINGSQL_RETENTION_ENABLED=true
LINGSQL_RETENTION_DRY_RUN=true

