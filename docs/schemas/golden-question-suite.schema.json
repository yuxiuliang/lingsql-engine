{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lingsql.example/schemas/golden-question-suite.schema.json",
  "title": "LingSQL 40题黄金问题签字真源",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "suiteId", "suiteVersion", "sowId", "frozenAt", "environment", "businessCases", "securityCases"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "suiteId": {"type": "string", "minLength": 1, "maxLength": 100},
    "suiteVersion": {"type": "string", "minLength": 1, "maxLength": 50},
    "sowId": {"type": "string", "minLength": 1, "maxLength": 100},
    "frozenAt": {"type": "string", "format": "date-time"},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environmentId", "releaseCommit", "flywaySchemaVersion", "dataSnapshotId", "modelRouteFingerprint", "modelProvider", "modelName", "modelVersion", "networkProfile", "concurrency"],
      "properties": {
        "environmentId": {"type": "string", "minLength": 1},
        "releaseCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "flywaySchemaVersion": {"type": "string", "minLength": 1},
        "dataSnapshotId": {"type": "string", "minLength": 1},
        "modelRouteFingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "modelProvider": {"type": "string", "minLength": 1},
        "modelName": {"type": "string", "minLength": 1},
        "modelVersion": {"type": "string", "minLength": 1},
        "networkProfile": {"type": "string", "minLength": 1},
        "concurrency": {"const": 1}
      }
    },
    "businessCases": {
      "type": "array",
      "minItems": 40,
      "maxItems": 40,
      "items": {"$ref": "#/$defs/businessCase"}
    },
    "securityCases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/securityCase"}
    }
  },
  "$defs": {
    "caseId": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{2,39}$"},
    "businessCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "priority", "question", "mode", "baselineSeconds", "expected"],
      "properties": {
        "id": {"$ref": "#/$defs/caseId"},
        "priority": {"enum": ["P0", "P1"]},
        "question": {"type": "string", "minLength": 1, "maxLength": 2000},
        "mode": {"const": "INDEPENDENT"},
        "baselineSeconds": {"type": "number", "exclusiveMinimum": 0},
        "classification": {"type": "string", "maxLength": 100},
        "expected": {
          "oneOf": [
            {"$ref": "#/$defs/scalarNumberExpected"},
            {"$ref": "#/$defs/rowsetExpected"}
          ]
        }
      }
    },
    "scalarNumberExpected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "rowIndex", "column", "value", "absoluteTolerance", "relativeTolerance"],
      "properties": {
        "kind": {"const": "SCALAR_NUMBER"},
        "rowIndex": {"type": "integer", "minimum": 0},
        "column": {"type": "string", "minLength": 1},
        "value": {"type": "number"},
        "absoluteTolerance": {"type": "number", "minimum": 0},
        "relativeTolerance": {"type": "number", "minimum": 0}
      }
    },
    "rowsetExpected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "columns", "rows", "orderSensitive"],
      "properties": {
        "kind": {"const": "ROWSET"},
        "columns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "rows": {"type": "array", "items": {"type": "object"}},
        "orderSensitive": {"type": "boolean"}
      }
    },
    "securityCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "question", "expected"],
      "properties": {
        "id": {"$ref": "#/$defs/caseId"},
        "kind": {"enum": ["WRITE_SQL", "CROSS_TENANT", "OUT_OF_ALLOWLIST"]},
        "question": {"type": "string", "minLength": 1, "maxLength": 2000},
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "failureCode"],
          "properties": {
            "kind": {"const": "REJECTION"},
            "failureCode": {
              "enum": ["SECURITY_WRITE_BLOCKED", "SECURITY_TENANT_SCOPE_BLOCKED", "SECURITY_ALLOWLIST_BLOCKED"]
            }
          }
        }
      }
    }
  }
}
